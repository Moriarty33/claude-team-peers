{
  "name": "team-peers",
  "version": "0.2.0",
  "private": true,
  "description": "Chat between teammates' Claude Code sessions over Azure Service Bus, delivered through Claude Code Channels",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "node --test test/*.test.ts",
    "smoke": "node test/smoke.e2e.ts"
  },
  "dependencies": {
    "@azure/identity": "4.14.1",
    "@azure/keyvault-keys": "4.10.2",
    "@azure/service-bus": "7.10.0",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
